[Unit]
Description=Maestro Telegram Operator UI
Documentation=file:/root/projects/Symphony/Maestro/docs/vps_systemd.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/projects/Symphony/Maestro
EnvironmentFile=/etc/maestro/maestro.env
ExecStart=/root/projects/Symphony/Maestro/.venv/bin/maestro telegram-operator --config ${MAESTRO_READONLY_CONFIG} --timeout-seconds 10
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
