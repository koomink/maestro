[Unit]
Description=Maestro resume tracking for live orders left outstanding by a closed poll window
Documentation=file:/home/symphony/maestro/docs/vps_systemd.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=symphony
Group=symphony
UMask=0077
WorkingDirectory=/home/symphony/maestro
EnvironmentFile=/etc/maestro/maestro.env
ExecStart=/home/symphony/maestro/.venv/bin/maestro resume-order-tracking --config ${MAESTRO_READONLY_CONFIG}
TimeoutStartSec=120
StandardOutput=journal
StandardError=journal
