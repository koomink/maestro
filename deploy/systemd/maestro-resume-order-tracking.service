[Unit]
Description=Maestro resume tracking for live orders left outstanding by a closed poll window
Documentation=file:/root/projects/Symphony/Maestro/docs/vps_systemd.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/root/projects/Symphony/Maestro
EnvironmentFile=/etc/maestro/maestro.env
ExecStart=/root/projects/Symphony/Maestro/.venv/bin/maestro resume-order-tracking --config ${MAESTRO_READONLY_CONFIG}
TimeoutStartSec=120
StandardOutput=journal
StandardError=journal
