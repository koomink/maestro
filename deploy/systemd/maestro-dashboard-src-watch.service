[Unit]
Description=Restart Maestro dashboard when backend source (src/maestro) changes
Documentation=file:/root/projects/Symphony/Maestro/docs/vps_systemd.md
After=network.target

# Complements maestro-dashboard.path, which only watches the operator config
# files and the built frontend (systemd .path units are not recursive). This
# service recursively watches src/maestro/ so a backend code change (e.g. a
# git pull or file edit touching orchestration/, config/, execution/,
# monitoring/, ...) triggers a restart instead of silently running stale code
# until someone notices and restarts manually.
[Service]
Type=simple
ExecStart=/bin/bash /root/projects/Symphony/Maestro/deploy/scripts/watch_dashboard_backend.sh
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
