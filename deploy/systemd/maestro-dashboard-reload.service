[Unit]
Description=Restart Maestro dashboard after a config/asset change
Documentation=file:/home/symphony/maestro/docs/vps_systemd.md

# Triggered by maestro-dashboard.path. A short delay debounces bursty writes
# (e.g. a vite build replacing several files at once) into a single restart.
[Service]
Type=oneshot
ExecStartPre=/bin/sleep 3
ExecStart=/usr/bin/systemctl restart maestro-dashboard.service
