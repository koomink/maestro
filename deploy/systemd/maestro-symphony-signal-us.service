[Unit]
Description=Maestro Symphony daily signal approval (US strategies, US session)
Documentation=file:/root/projects/Symphony/Maestro/docs/vps_systemd.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/root/projects/Symphony/Maestro
EnvironmentFile=/etc/maestro/maestro.env
ExecStart=/root/projects/Symphony/Maestro/.venv/bin/maestro daily-signal-approval --readonly-config ${MAESTRO_READONLY_CONFIG} --signal-config ${MAESTRO_SIGNAL_CONFIG} --approval-config ${MAESTRO_APPROVAL_CONFIG} --strategy-ids crescendo_us
TimeoutStartSec=1200
StandardOutput=journal
StandardError=journal
